<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fon">

    <!-- Кнопки фильтра -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filterGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:selectionRequired="false"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/btn_all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Все"
            android:layout_weight="1"
            android:buttonTint="#1a4d99"
            android:checked="true"
            android:gravity="center"
            android:textColor="#1a4d99" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btn_app"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Приложение"
            android:layout_weight="1"
            android:buttonTint="#1a4d99"
            android:checked="true"
            android:gravity="center"
            android:textColor="#1a4d99" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btn_site"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сайт"
            android:layout_weight="1"
            android:buttonTint="#1a4d99"
            android:checked="true"
            android:gravity="center"
            android:textColor="#1a4d99" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btn_docs"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Документы"
            android:layout_weight="1"
            android:buttonTint="#1a4d99"
            android:checked="true"
            android:gravity="center"
            android:textColor="#1a4d99" />

    </com.google.android.material.chip.ChipGroup>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/filterGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/sections_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>